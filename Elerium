local function SetProps(inst, props)
    if props then
        for k, v in pairs(props) do inst[k] = v end
    end
    return inst
end

local function SetChildren(inst, children)
    if children then
        for _, child in ipairs(children) do child.Parent = inst end
    end
    return inst
end

local function InsertTheme(inst, themeType)
    table.insert(lib.Instances, { Instance = inst, Type = themeType })
    return inst
end

local function Create(className, parent, props, children)
    local inst
    if typeof(parent) == "Instance" then
        inst = Instance.new(className)
        inst.Parent = parent
        SetProps(inst, props)
        SetChildren(inst, children)
    else
        -- parent is actually a props table
        inst = Instance.new(className)
        SetProps(inst, parent)
        SetChildren(inst, props)
    end
    return inst
end

local activeTweens = {}
local function Tween(inst, props, time, wait)
    time = time or Config.tween_time
    if activeTweens[inst] then activeTweens[inst]:Cancel() end
    local info = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tw = TweenService:Create(inst, info, props)
    activeTweens[inst] = tw
    tw:Play()
    if wait then tw.Completed:Wait() end
    return tw
end

local function GetColorProp(inst)
    if inst:IsA("Frame") or inst:IsA("TextButton") or inst:IsA("ImageButton") then
        return "BackgroundColor3"
    elseif inst:IsA("ImageLabel") then
        return "ImageColor3"
    elseif inst:IsA("TextLabel") or inst:IsA("TextBox") then
        return "TextColor3"
    elseif inst:IsA("ScrollingFrame") then
        return "ScrollBarImageColor3"
    elseif inst:IsA("UIStroke") then
        return "Color"
    end
    return nil
end

function lib:SetTheme(name)
    if not self.Themes[name] then return end
    self.Save.Theme = name
    Theme = self.Themes[name]
    for _, entry in ipairs(self.Instances) do
        if not entry or not entry.Instance or not entry.Instance.Parent then continue end
        local inst = entry.Instance
        local prop = GetColorProp(inst)
        if entry.Type == "Background" then
            inst.BackgroundColor3 = Theme["Color Background"]
        elseif entry.Type == "Bar" then
            inst.BackgroundColor3 = Theme["Color Bar"]
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                inst.ImageColor3 = Theme["Color Bar"]
            end
        elseif entry.Type == "Tab" then
            inst.BackgroundColor3 = Theme["Color Tab"]
        elseif entry.Type == "Element" then
            if prop then inst[prop] = Theme["Color Element"] end
        elseif entry.Type == "Stroke" then
            if prop then inst[prop] = Theme["Color Stroke"] end
        elseif entry.Type == "Theme" then
            if prop then inst[prop] = Theme["Color Theme"] end
        elseif entry.Type == "Text" then
            if prop then inst[prop] = Theme["Color Text"] end
        elseif entry.Type == "Bright" then
            if prop then inst[prop] = Theme["Color Bright"] end
        elseif entry.Type == "Scroll" then
            if inst:IsA("ScrollingFrame") then
                inst.ScrollBarImageColor3 = Theme["Color Scroll"]
            end
        end
    end
end

local function GetMouse()

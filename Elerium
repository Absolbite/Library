                local ddAbsY = ddBtn.AbsolutePosition.Y
                local ddAbsH = ddBtn.AbsoluteSize.Y
                local screenH = window.AbsolutePosition.Y + window.AbsoluteSize.Y
                local spaceBelow = screenH - (ddAbsY + ddAbsH)
                if spaceBelow < h then
                    boxFlipped = true
                    box.Position = UDim2.new(0, 0, 0, -h - 5)
                else
                    boxFlipped = false
                    box.Position = UDim2.new(0, 0, 0, 30)

                if not boxOpen then return end
                boxOpen = false
                if boxFlipped then
                    Tween(box, { Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, -5) }, tweenT)

                    task.delay(tweenT, function()

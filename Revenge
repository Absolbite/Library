                Size                    = UDim2.new(0.9, 0, 0.9, 0),
                AnchorPoint             = Vector2.new(0.5, 0.5),
                Position                = UDim2.new(0.5, 0, 0.5, 0),
                ClearTextOnFocus        = clearOnFocus,
                TextXAlignment          = Enum.TextXAlignment.Left,
            }), "Text")

            box.FocusLost:Connect(function()
                local t = box.Text
                if t:gsub(" ", ""):len() > 0 then
                    SetFlag(flag, t)
                    pcall(callback, t)
                end
            end)

            local TB = {}
            function TB:Set(v)
                if type(v) == "string" then
                    box.Text = v; SetFlag(flag, v); pcall(callback, v)
                end
            end
            function TB:Visible(b) row.Visible = (b ~= nil) and b or (not row.Visible) end
            function TB:Destroy() row:Destroy() end
            return TB
        end

        function bU:AddThemeSelector()
            -- Divider label
            bU:AddDivider("Themes")

            local themeNames = {}
            for k in pairs(Themes) do table.insert(themeNames, k) end
            table.sort(themeNames)

            local holder = New("Frame", Container, {
                BackgroundTransparency  = 1,
                Size                    = UDim2.new(1, 0, 0, 28),
                Name                    = "Option",
            })
            New("UIGridLayout", holder, {
                CellSize    = UDim2.new(0, 60, 0, 22),
                CellPadding = UDim2.fromOffset(4, 4),
                SortOrder   = Enum.SortOrder.LayoutOrder,
            })

            for _, name in ipairs(themeNames) do
                local isAct = (name == Save.Theme)
                local tBtn = InsertTheme(New("TextButton", holder, {
                    BackgroundColor3    = Theme["Hub 2"],
                    Font                = Enum.Font.GothamBold,
                    Text                = name,
                    TextSize            = 8,
                    TextColor3          = isAct and Theme["Theme"] or Theme["Text"],
                    AutoButtonColor     = false,
                    Name                = name,
                }), "Hub2")
                Corner(tBtn, UDim.new(0, 4))
                if isAct then Stroke(tBtn) end
                tBtn.Activated:Connect(function()
                    ApplyTheme(name)
                    for _, ch in ipairs(holder:GetChildren()) do
                        if ch:IsA("TextButton") then
                            ch.TextColor3 = ch.Name == name and Theme["Theme"] or Theme["Text"]
                        end
                    end
                end)
            end

            local layout = holder:FindFirstChildOfClass("UIGridLayout")
            local function UpdateH()
                local rows = math.ceil(#themeNames / math.floor(holder.AbsoluteSize.X / 64))
                holder.Size = UDim2.new(1, 0, 0, rows * 26 + 4)
            end
            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateH)
            task.defer(UpdateH)
        end

        return bU, tabFrame
    end

    return bx, win
end

if script then
    script.AncestryChanged:Connect(function()
        if not script.Parent then av() end
    end)
end

return bd

				iContent.Size = UDim2.new(1,-180,0,12)
				iContent.Parent = elem

				local inputFrame = Instance.new("Frame")
				inputFrame.AnchorPoint = Vector2.new(1,0.5)
				inputFrame.BackgroundColor3 = Color3.fromRGB(255,255,255)
				inputFrame.BackgroundTransparency = 0.95
				inputFrame.BorderSizePixel = 0
				inputFrame.ClipsDescendants = true
				inputFrame.Position = UDim2.new(1,-7,0.5,0)
				inputFrame.Size = UDim2.new(0,148,0,30)
				inputFrame.Parent = elem

				Instance.new("UICorner",inputFrame).CornerRadius = UDim.new(0,4)

				local textBox = Instance.new("TextBox")
				textBox.CursorPosition = -1
				textBox.Font = Enum.Font.GothamBold
				textBox.PlaceholderText = "Enter value..."
				textBox.PlaceholderColor3 = Color3.fromRGB(120,120,120)
				textBox.Text = ""
				textBox.TextColor3 = Color3.fromRGB(255,255,255)
				textBox.TextSize = 12
				textBox.TextXAlignment = Enum.TextXAlignment.Left
				textBox.BackgroundTransparency = 1
				textBox.BorderSizePixel = 0
				textBox.AnchorPoint = Vector2.new(0,0.5)
				textBox.Position = UDim2.new(0,5,0.5,0)
				textBox.Size = UDim2.new(1,-10,1,-8)
				textBox.Parent = inputFrame

				local inputObj = { Value = elemCfg.Default }

				function inputObj:Set(val)
					textBox.Text = tostring(val)
					self.Value = val
					if elemCfg.Flag then SetFlag(elemCfg.Flag, val) end
					elemCfg.Callback(val)
				end

				textBox.FocusLost:Connect(function()
					inputObj:Set(textBox.Text)
				end)

				inputObj:Set(elemCfg.Default)
				elemIndex += 1
				return inputObj
			end

			-- ── Dropdown (Single + Multi — fully fixed Touch/Mouse)
			function sectionLib:AddDropdown(elemCfg)
				elemCfg = elemCfg or {}
				elemCfg.Title    = elemCfg.Title    or "Dropdown"
				elemCfg.Content  = elemCfg.Content  or ""
				elemCfg.Multi    = elemCfg.Multi    or false
				elemCfg.Options  = elemCfg.Options  or {}
				elemCfg.Default  = elemCfg.Default  or {}
				elemCfg.Flag     = elemCfg.Flag     or nil
				elemCfg.Callback = elemCfg.Callback or function() end

				if elemCfg.Flag and GetFlag(elemCfg.Flag) ~= nil then
					elemCfg.Default = GetFlag(elemCfg.Flag)
				end
				if type(elemCfg.Default) == "string" then
					elemCfg.Default = { elemCfg.Default }
				end

				local myDropIndex = dropPageLayout and 0 or 0
				-- count existing drop pages
				for _, c in dropPagesFolder:GetChildren() do
					if c:IsA("ScrollingFrame") then myDropIndex += 1 end
				end

				local elem = Instance.new("Frame")
				elem.BackgroundColor3 = Color3.fromRGB(255,255,255)
				elem.BackgroundTransparency = 0.935
				elem.BorderSizePixel = 0
				elem.LayoutOrder = elemIndex
				elem.Size = UDim2.new(1,0,0,46)
				elem.Name = "Dropdown"
				elem.Parent = contentFrame

				Instance.new("UICorner",elem).CornerRadius = UDim.new(0,4)

				local dTitle = Instance.new("TextLabel")
				dTitle.Font = Enum.Font.GothamBold
				dTitle.Text = elemCfg.Title
				dTitle.TextColor3 = Color3.fromRGB(231,231,231)
				dTitle.TextSize = 13
				dTitle.TextXAlignment = Enum.TextXAlignment.Left
				dTitle.BackgroundTransparency = 1
				dTitle.BorderSizePixel = 0
				dTitle.Position = UDim2.new(0,10,0,10)
				dTitle.Size = UDim2.new(1,-180,0,13)
				dTitle.Parent = elem

				local dContent = Instance.new("TextLabel")
				dContent.Font = Enum.Font.GothamBold
				dContent.Text = elemCfg.Content
				dContent.TextColor3 = Color3.fromRGB(150,150,150)
				dContent.TextSize = 12
				dContent.TextWrapped = true
				dContent.BackgroundTransparency = 1
				dContent.BorderSizePixel = 0
				dContent.Position = UDim2.new(0,10,0,23)
				dContent.Size = UDim2.new(1,-180,0,12)
				dContent.Parent = elem

				local selFrame = Instance.new("Frame")
				selFrame.AnchorPoint = Vector2.new(1,0.5)
				selFrame.BackgroundColor3 = Color3.fromRGB(255,255,255)
				selFrame.BackgroundTransparency = 0.95
				selFrame.BorderSizePixel = 0
				selFrame.Position = UDim2.new(1,-7,0.5,0)
				selFrame.Size = UDim2.new(0,148,0,30)
				selFrame.LayoutOrder = myDropIndex
				selFrame.Parent = elem

				Instance.new("UICorner",selFrame).CornerRadius = UDim.new(0,4)

				local selBtn = Instance.new("TextButton")
				selBtn.Text = ""
				selBtn.BackgroundTransparency = 1
				selBtn.BorderSizePixel = 0
				selBtn.Size = UDim2.new(1,0,1,0)
				selBtn.Parent = selFrame

				local selText = Instance.new("TextLabel")
				selText.Font = Enum.Font.GothamBold
				selText.Text = "Select..."
				selText.TextColor3 = Color3.fromRGB(150,150,150)
				selText.TextSize = 12
				selText.TextWrapped = true
				selText.TextXAlignment = Enum.TextXAlignment.Left
				selText.BackgroundTransparency = 1
				selText.BorderSizePixel = 0
				selText.AnchorPoint = Vector2.new(0,0.5)
				selText.Position = UDim2.new(0,5,0.5,0)
				selText.Size = UDim2.new(1,-30,1,-8)
				selText.Parent = selFrame

				local arrowImg2 = Instance.new("ImageLabel")
				arrowImg2.Image = "rbxassetid://16851841101"
				arrowImg2.ImageColor3 = Color3.fromRGB(231,231,231)
				arrowImg2.AnchorPoint = Vector2.new(1,0.5)
				arrowImg2.BackgroundTransparency = 1
				arrowImg2.BorderSizePixel = 0
				arrowImg2.Position = UDim2.new(1,0,0.5,0)
				arrowImg2.Size = UDim2.new(0,25,0,25)
				arrowImg2.Parent = selFrame

				-- Drop list (scrolling frame inside dropPagesFolder)
				local dropListScroll = Instance.new("ScrollingFrame")
				dropListScroll.CanvasSize = UDim2.new(0,0,0,0)
				dropListScroll.ScrollBarThickness = 0
				dropListScroll.Active = true
				dropListScroll.LayoutOrder = myDropIndex
				dropListScroll.BackgroundTransparency = 1
				dropListScroll.BorderSizePixel = 0
				dropListScroll.Size = UDim2.new(1,0,1,0)
				dropListScroll.Name = "DropList"
				dropListScroll.Parent = dropPagesFolder

				local dropItemList = Instance.new("UIListLayout")
				dropItemList.Padding = UDim.new(0,3)
				dropItemList.SortOrder = Enum.SortOrder.LayoutOrder
				dropItemList.Parent = dropListScroll

				local dropObj = {
					Value   = elemCfg.Default,
					Options = elemCfg.Options,
				}

				local function updateSelText()
					local str = table.concat(dropObj.Value, ", ")
					selText.Text = str ~= "" and str or "Select..."
				end

				function dropObj:Set(val)
					self.Value = val or self.Value
					updateSelText()
					if elemCfg.Flag then SetFlag(elemCfg.Flag, self.Value) end
					elemCfg.Callback(self.Value)
					-- Update option visuals
					for _, c in dropListScroll:GetChildren() do
						if c.Name == "DropOption" then
							local selected = table.find(self.Value, c:GetAttribute("OptionValue"))
							if selected then
								tweenLinear(c, 0.2, { BackgroundTransparency = 0.85 })
								local mark = c:FindFirstChild("Mark")
								if mark then tweenLinear(mark, 0.2, { BackgroundColor3 = guiColor, Size = UDim2.new(0,3,0,14) }) end
							else
								tweenLinear(c, 0.2, { BackgroundTransparency = 0.999 })
								local mark = c:FindFirstChild("Mark")
								if mark then tweenLinear(mark, 0.2, { Size = UDim2.new(0,0,0,0) }) end
							end
						end
					end
				end

				function dropObj:Clear()
					self.Value = {}
					self.Options = {}
					selText.Text = "Select..."
					for _, c in dropListScroll:GetChildren() do
						if c.Name == "DropOption" then c:Destroy() end
					end
				end

				function dropObj:AddOption(optName)
					optName = tostring(optName or "Option")
					local opt = Instance.new("Frame")
					opt.BackgroundColor3 = Color3.fromRGB(255,255,255)
					opt.BackgroundTransparency = 0.999
					opt.BorderSizePixel = 0
					opt.Size = UDim2.new(1,0,0,30)
					opt.Name = "DropOption"
					opt:SetAttribute("OptionValue", optName)
					opt.Parent = dropListScroll

					Instance.new("UICorner",opt).CornerRadius = UDim.new(0,3)

					local mark = Instance.new("Frame")
					mark.AnchorPoint = Vector2.new(0,0.5)
					mark.BackgroundColor3 = guiColor
					mark.BorderSizePixel = 0
					mark.Position = UDim2.new(0,3,0.5,0)
					mark.Size = UDim2.new(0,0,0,0)
					mark.Name = "Mark"
					mark.Parent = opt
					Instance.new("UICorner",mark)

					local optLabel = Instance.new("TextLabel")
					optLabel.Font = Enum.Font.GothamBold
					optLabel.Text = optName
					optLabel.TextColor3 = Color3.fromRGB(231,231,231)
					optLabel.TextSize = 13
					optLabel.TextXAlignment = Enum.TextXAlignment.Left
					optLabel.BackgroundTransparency = 1
					optLabel.BorderSizePixel = 0
					optLabel.Position = UDim2.new(0,10,0,0)
					optLabel.Size = UDim2.new(1,-20,1,0)
					optLabel.Parent = opt

					local optBtn = Instance.new("TextButton")
					optBtn.Text = ""
					optBtn.BackgroundTransparency = 1
					optBtn.BorderSizePixel = 0
					optBtn.Size = UDim2.new(1,0,1,0)
					optBtn.Parent = opt

					optBtn.Activated:Connect(function()
						ripple(optBtn, getInputPos())
						if elemCfg.Multi then
							local idx = table.find(dropObj.Value, optName)
							if idx then
								table.remove(dropObj.Value, idx)
							else
								table.insert(dropObj.Value, optName)
							end
							dropObj:Set(dropObj.Value)
						else
							dropObj:Set({ optName })
							-- Close panel
							tweenLinear(dropOverlay, 0.2, { BackgroundTransparency = 0.999 })
							tweenLinear(dropPanel, 0.2, { Position = UDim2.new(1,172,0.5,0) })
							task.wait(0.3)
							dropOverlay.Visible = false
						end
					end)

					-- Update canvas
					local h = 0
					for _, c in dropListScroll:GetChildren() do
						if c.Name == "DropOption" then h = h + 3 + c.Size.Y.Offset end
					end
					dropListScroll.CanvasSize = UDim2.new(0,0,0,h)
				end

				function dropObj:Refresh(opts, defaults)
					opts = opts or {}
					defaults = defaults or {}
					self:Clear()
					for _, v in ipairs(opts) do self:AddOption(v) end
					self.Options = opts
					self:Set(defaults)
				end

				selBtn.Activated:Connect(function()
					if not dropOverlay.Visible then
						dropOverlay.Visible = true
						dropPageLayout:JumpToIndex(selFrame.LayoutOrder)
						tweenLinear(dropOverlay, 0.2, { BackgroundTransparency = 0.7 })
						tweenLinear(dropPanel, 0.2, { Position = UDim2.new(1,-11,0.5,0) })
					end
				end)

				dropObj:Refresh(elemCfg.Options, elemCfg.Default)
				elemIndex += 1
				return dropObj
			end

			-- ── Plain Section label (from UI-1.3 style)
			function sectionLib:AddLabel(name)
				name = name or ""
				local labelFrame = Instance.new("Frame")
				labelFrame.BackgroundTransparency = 1
				labelFrame.BorderSizePixel = 0
				labelFrame.LayoutOrder = elemIndex
				labelFrame.Size = UDim2.new(1,0,0,20)
				labelFrame.Name = "Label"
				labelFrame.Parent = contentFrame

				local lbl = Instance.new("TextLabel")
				lbl.Font = Enum.Font.GothamBold
				lbl.Text = name
				lbl.TextColor3 = Color3.fromRGB(231,231,231)
				lbl.TextSize = 14
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.BackgroundTransparency = 1
				lbl.BorderSizePixel = 0
				lbl.Position = UDim2.new(0,5,0,0)
				lbl.Size = UDim2.new(1,-10,1,0)
				lbl.Parent = labelFrame

				if cfg.Theme and Themes[cfg.Theme] then
					lbl.TextColor3 = Themes[cfg.Theme].Text
				end

				local obj = {}
				function obj:Set(text) lbl.Text = text or "" end
				function obj:Visible(v)
					if v == nil then labelFrame.Visible = not labelFrame.Visible
					else labelFrame.Visible = v end
				end
				function obj:Destroy() labelFrame:Destroy() end
				elemIndex += 1
				return obj
			end

			return sectionLib
		end

		tabIndex += 1
		return tabSections
	end

	return guiTabs
end

return SpLib

            -- ====================================================
            --  AddToggle
            -- ====================================================
            function Section:AddToggle(cfg2)
                cfg2 = cfg2 or {}
                local name     = cfg2.Name    or "Toggle"
                local flag     = cfg2.Flag
                local callback = cfg2.Callback or function() end
                local default  = cfg2.Default  or false

                -- Load from saved flags
                local toggled = default
                if flag and DorionFlags[flag] ~= nil then
                    toggled = DorionFlags[flag]
                end

                local row = Create("Frame", {
                    Size=UDim2.new(1,0,0,44), BackgroundColor3=C.Row,
                    BorderSizePixel=0, Parent=items,
                })
                Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=C.Border, BorderSizePixel=0, Parent=row})

                local lbl = Create("TextLabel", {
                    Text=name, Size=UDim2.new(1,-70,1,0), Position=UDim2.new(0,12,0,0),
                    BackgroundTransparency=1, TextColor3=toggled and C.Text or C.TextDim,
                    TextSize=13, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
                    Parent=row,
                })

                local track = Create("Frame", {
                    Size=UDim2.new(0,44,0,22), Position=UDim2.new(1,-54,0.5,-11),
                    BackgroundColor3=toggled and C.Toggle_ON or C.Toggle_OFF,
                    BorderSizePixel=0, Parent=row,
                })
                Create("UICorner", {CornerRadius=UDim.new(1,0), Parent=track})

                local thumb = Create("Frame", {
                    Size=UDim2.new(0,16,0,16),
                    Position=toggled and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8),
                    BackgroundColor3=rgb(255,255,255), BorderSizePixel=0, Parent=track,
                })
                Create("UICorner", {CornerRadius=UDim.new(1,0), Parent=thumb})

                table.insert(Window._ThemeElements, {row,   "BackgroundColor3", "Row"})
                table.insert(Window._ThemeElements, {track, "BackgroundColor3", toggled and "Toggle_ON" or "Toggle_OFF"})

                local function setToggle(val)
                    toggled = val
                    Tween(track, {BackgroundColor3=toggled and C.Toggle_ON or C.Toggle_OFF}, 0.15)
                    Tween(thumb, {Position=toggled and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}, 0.15)
                    lbl.TextColor3 = toggled and C.Text or C.TextDim
                    if flag then
                        DorionFlags[flag] = toggled
                        SaveFlags()
                    end
                    pcall(callback, toggled)
                end

                Create("TextButton", {
                    Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", Parent=row,
                }).MouseButton1Click:Connect(function() setToggle(not toggled) end)

                row.MouseEnter:Connect(function() Tween(row,{BackgroundColor3=C.RowHover},0.1) end)
                row.MouseLeave:Connect(function() Tween(row,{BackgroundColor3=C.Row},0.1) end)

                local TogObj = {}
                function TogObj:Set(v) setToggle(v) end
                function TogObj:Get() return toggled end
                -- Fire callback with saved value on load
                if flag and DorionFlags[flag] ~= nil then pcall(callback, toggled) end
                return TogObj
            end

            -- ====================================================
            --  AddDropdown  (always multi-select)
            -- ====================================================
            function Section:AddDropdown(cfg2)
                cfg2 = cfg2 or {}
                local name     = cfg2.Name     or "Dropdown"
                local options  = cfg2.Options  or {}
                local flag     = cfg2.Flag
                local callback = cfg2.Callback or function() end
                local default  = cfg2.Default

                -- Normalize default to table
                if type(default) == "string" then default = {default} end
                if type(default) ~= "table"  then default = {} end

                -- Load from flags
                local selected = {}
                if flag and DorionFlags[flag] and type(DorionFlags[flag])=="table" then
                    selected = DorionFlags[flag]
                else
                    for _, v in ipairs(default) do
                        if table.find(options, v) then
                            table.insert(selected, v)
                        end
                    end
                end

                local dropOpen = false

                local function getDisplayText()
                    if #selected == 0 then return "None"
                    elseif #selected == 1 then return selected[1]
                    else return selected[1].." +"..tostring(#selected-1) end
                end

                local row = Create("Frame", {
                    Size=UDim2.new(1,0,0,44), BackgroundColor3=C.Row,
                    BorderSizePixel=0, ClipsDescendants=false, Parent=items,
                })
                Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=C.Border, BorderSizePixel=0, Parent=row})

                Create("TextLabel", {
                    Text=name, Size=UDim2.new(0.45,0,1,0), Position=UDim2.new(0,12,0,0),
                    BackgroundTransparency=1, TextColor3=C.TextDim, TextSize=13,
                    Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left, Parent=row,
                })

                local dropBtn = Create("TextButton", {
                    Size=UDim2.new(0,145,0,28), Position=UDim2.new(1,-155,0.5,-14),
                    BackgroundColor3=C.InputBG, BorderSizePixel=0, Text="", AutoButtonColor=false, Parent=row,
                })
                Create("UICorner", {CornerRadius=UDim.new(0,5), Parent=dropBtn})
                Create("UIStroke", {Color=C.Border, Thickness=1, Parent=dropBtn})

                local selLbl = Create("TextLabel", {
                    Text=getDisplayText(), Size=UDim2.new(1,-22,1,0), Position=UDim2.new(0,6,0,0),
                    BackgroundTransparency=1, TextColor3=C.Text, TextSize=11, Font=Enum.Font.Gotham,
                    TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, Parent=dropBtn,
                })

                Create("TextLabel", {
                    Text="∨", Size=UDim2.new(0,14,1,0), Position=UDim2.new(1,-16,0,0),
                    BackgroundTransparency=1, TextColor3=C.TextDim, TextSize=10, Font=Enum.Font.GothamBold,
                    Parent=dropBtn,
                })

                -- Dropdown list
                local dropList = Create("Frame", {
                    Size=UDim2.new(0,155,0,0), Position=UDim2.new(1,-155,1,2),
                    BackgroundColor3=C.DropdownBG, BorderSizePixel=0,
                    ClipsDescendants=true, ZIndex=20, Visible=false, Parent=row,
                })
                Create("UICorner", {CornerRadius=UDim.new(0,6), Parent=dropList})
                Create("UIStroke", {Color=C.Accent, Thickness=1, Parent=dropList})

                local dSearch = Create("TextBox", {
                    PlaceholderText="Search", Text="",
                    Size=UDim2.new(1,-8,0,24), Position=UDim2.new(0,4,0,4),
                    BackgroundColor3=C.InputBG, BorderSizePixel=0,
                    TextColor3=C.Text, PlaceholderColor3=C.TextMuted,
                    TextSize=11, Font=Enum.Font.Gotham,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    ClearTextOnFocus=false, ZIndex=21, Parent=dropList,
                })
                Create("UICorner", {CornerRadius=UDim.new(0,4), Parent=dSearch})
                Create("UIPadding", {PaddingLeft=UDim.new(0,5), Parent=dSearch})

                local dScroll = Create("ScrollingFrame", {
                    Size=UDim2.new(1,0,1,-32), Position=UDim2.new(0,0,0,32),
                    BackgroundTransparency=1, BorderSizePixel=0,
                    ScrollBarThickness=2, ScrollBarImageColor3=C.Scrollbar,
                    CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
                    ZIndex=21, Parent=dropList,
                })
                Create("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,0), Parent=dScroll})

                local optBtns = {}

                local function saveDropdown()
                    if flag then
                        DorionFlags[flag] = selected
                        SaveFlags()
                    end
                    pcall(callback, selected)
                    selLbl.Text = getDisplayText()
                end

                local function rebuildOpts(filter)
                    for _, b in ipairs(optBtns) do pcall(function() b:Destroy() end) end
                    optBtns = {}
                    local count = 0
                    for _, opt in ipairs(options) do
                        if filter=="" or opt:lower():find(filter:lower(),1,true) then
                            count = count + 1
                            local isSelected = table.find(selected, opt) ~= nil
                            local ob = Create("TextButton", {
                                Text="",
                                Size=UDim2.new(1,0,0,28),
                                BackgroundColor3=isSelected and C.AccentDark or C.DropdownBG,
                                BorderSizePixel=0, AutoButtonColor=false, ZIndex=22, Parent=dScroll,
                            })
                            Create("UIPadding", {PaddingLeft=UDim.new(0,8), Parent=ob})

                            -- checkbox
                            local check = Create("TextLabel", {
                                Text=isSelected and "✓" or "", Size=UDim2.new(0,16,0,16),
                                Position=UDim2.new(0,-4,0.5,-8),
                                BackgroundTransparency=1, TextColor3=C.Accent, TextSize=12,
                                Font=Enum.Font.GothamBold, ZIndex=23, Parent=ob,
                            })
                            Create("TextLabel", {
                                Text=opt, Size=UDim2.new(1,-18,1,0), Position=UDim2.new(0,16,0,0),
                                BackgroundTransparency=1, TextColor3=isSelected and C.Text or C.TextDim,
                                TextSize=11, Font=isSelected and Enum.Font.GothamSemibold or Enum.Font.Gotham,
                                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=23, Parent=ob,
                            })

                            ob.MouseEnter:Connect(function()
                                if not table.find(selected,opt) then Tween(ob,{BackgroundColor3=C.AccentDark},0.1) end
                            end)
                            ob.MouseLeave:Connect(function()
                                if not table.find(selected,opt) then Tween(ob,{BackgroundColor3=C.DropdownBG},0.1) end
                            end)

                            ob.MouseButton1Click:Connect(function()
                                local idx = table.find(selected, opt)
                                if idx then
                                    table.remove(selected, idx)
                                else
                                    table.insert(selected, opt)
                                end
                                saveDropdown()
                                rebuildOpts(dSearch.Text)
                            end)

                            table.insert(optBtns, ob)
                        end
                    end
                    -- Resize dropdown
                    if dropOpen then
                        local h = math.min(count*28, 168)
                        dropList.Size = UDim2.new(0,155,0,h+36)
                    end
                end

                dSearch:GetPropertyChangedSignal("Text"):Connect(function()
                    rebuildOpts(dSearch.Text)
                end)

                dropBtn.MouseButton1Click:Connect(function()
                    dropOpen = not dropOpen
                    if dropOpen then
                        dropList.Visible = true
                        dSearch.Text = ""
                        rebuildOpts("")
                        local h = math.min(#options*28, 168)
                        Tween(dropList, {Size=UDim2.new(0,155,0,h+36)}, 0.2)
                    else
                        Tween(dropList, {Size=UDim2.new(0,155,0,0)}, 0.15)
                        task.delay(0.16, function() dropList.Visible=false end)
                    end
                end)

                row.MouseEnter:Connect(function() Tween(row,{BackgroundColor3=C.RowHover},0.1) end)
                row.MouseLeave:Connect(function() Tween(row,{BackgroundColor3=C.Row},0.1) end)

                -- Fire initial callback
                if #selected > 0 then pcall(callback, selected) end

                local DropObj = {}

                -- dropObj:Set(list, keepPrevious)
                -- keepPrevious=true  → merge list into current selection
                -- keepPrevious=false → clear then set list
                function DropObj:Set(list, keepPrevious)
                    if not keepPrevious then
                        selected = {}
                    end
                    if type(list) == "string" then list = {list} end
                    for _, v in ipairs(list or {}) do
                        if table.find(options, v) and not table.find(selected, v) then
                            table.insert(selected, v)
                        end
                    end
                    saveDropdown()
                    rebuildOpts(dSearch.Text)
                end

                function DropObj:Get() return selected end

                function DropObj:SetOptions(newOpts, keepSelected)
                    options = newOpts
                    if not keepSelected then
                        selected = {}
                    else
                        -- remove any selected that no longer exist
                        local valid = {}
                        for _, v in ipairs(selected) do
                            if table.find(newOpts, v) then table.insert(valid, v) end
                        end
                        selected = valid
                    end
                    saveDropdown()
                    rebuildOpts("")
                end

                return DropObj
            end


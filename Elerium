            folderToggle.Position = UDim2.new(0, 5, 0, 0)
            folderToggle.Size     = UDim2.new(0, 25, 0, 25)
            folderToggle.Image    = "https://www.roblox.com/Thumbs/Asset.ashx?width=420&height=420&assetId=4731371541"

            local objsFrame = Instance.new("Frame")
            objsFrame.Name  = "Objects"
            objsFrame.Parent = folderFrame
            objsFrame.BackgroundTransparency = 1
            objsFrame.Position = UDim2.new(0, 10, 0, 30)
            objsFrame.Size     = UDim2.new(1, -10, 1, -30)
            objsFrame.Visible  = false
            local objsLayout = Instance.new("UIListLayout")
            objsLayout.Parent    = objsFrame
            objsLayout.SortOrder = Enum.SortOrder.LayoutOrder
            objsLayout.Padding   = UDim.new(0, 5)

            local isOpen = false
            local sizeConn

            local function CalcSize()
                local h = 30
                for _, ch in ipairs(objsFrame:GetChildren()) do
                    if not ch:IsA("UIListLayout") then
                        h = h + ch.AbsoluteSize.Y + 5
                    end
                end
                return h
            end

            folderBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    Tween(folderToggle, { Rotation = 90 }, tweenT)
                    objsFrame.Visible = true
                    if sizeConn then sizeConn:Disconnect() end
                    sizeConn = RunService.Heartbeat:Connect(function()
                        if isOpen then
                            folderFrame.Size = UDim2.new(1, 0, 0, CalcSize())
                        else
                            if sizeConn then sizeConn:Disconnect(); sizeConn = nil end
                        end
                    end)
                else
                    Tween(folderToggle, { Rotation = 0 }, tweenT)
                    objsFrame.Visible = false
                    folderFrame.Size  = UDim2.new(1, 0, 0, 25)
                    if sizeConn then sizeConn:Disconnect(); sizeConn = nil end
                end
            end)

            for methodName, method in pairs(tabObj) do
                folderObj[methodName] = function(_, ...)
                    local old = activeContainer
                    activeContainer = objsFrame
                    local result = { method(tabObj, ...) }
                    local inst = result[#result]
                    if inst and typeof(inst) == "Instance" then
                        inst.Parent = objsFrame
                    end
                    activeContainer = old
                    return table.unpack(result)
                end
            end
            return folderObj, folderFrame
        end

        function tabObj:AddSection(sectionName, startOpen)
            sectionName = tostring(sectionName or "Section")
            startOpen   = startOpen == true

            local sectionObj = {}

            local wrapper = Instance.new("Frame")
            wrapper.Parent = activeContainer
            wrapper.Size   = UDim2.new(1, 0, 0, 23)
            wrapper.BackgroundTransparency = 1
            wrapper.ClipsDescendants = true
            wrapper.Name   = "SectionWrapper"

            local headerBtn = InsertTheme(Instance.new("TextButton"), "Element")
            headerBtn.Parent = wrapper
            headerBtn.BackgroundColor3 = Theme["Color Element"]
            headerBtn.BackgroundTransparency = 0
            headerBtn.Text  = ""
            headerBtn.AutoButtonColor = false
            headerBtn.Size  = UDim2.new(1, 0, 0, 23)
            headerBtn.Name  = "SectionHeader"
            local hCorner = Instance.new("UICorner")
            hCorner.CornerRadius = UDim.new(0, 7)
            hCorner.Parent = headerBtn
            local hStroke = InsertTheme(Instance.new("UIStroke"), "Stroke")
            hStroke.Color = Theme["Color Stroke"]
            hStroke.Thickness = 1
            hStroke.ApplyStrokeMode = "Border"
            hStroke.Parent = headerBtn

            local headerLabel = InsertTheme(Instance.new("TextLabel"), "Text")
            headerLabel.Parent = headerBtn
            headerLabel.BackgroundTransparency = 1
            headerLabel.Font   = Enum.Font.GothamBold
            headerLabel.Text   = sectionName
            headerLabel.TextColor3 = Theme["Color Text"]
            headerLabel.TextSize = 10
            headerLabel.TextXAlignment = Enum.TextXAlignment.Left
            headerLabel.Size   = UDim2.new(1, -40, 1, 0)
            headerLabel.Position = UDim2.new(0, 12, 0, 0)
            headerLabel.TextTruncate = Enum.TextTruncate.AtEnd
            headerLabel.Name   = "SectionTitle"

            local arrow = InsertTheme(Instance.new("ImageLabel"), "Text")
            arrow.Parent = headerBtn
            arrow.BackgroundTransparency = 1
            arrow.Image   = "rbxassetid://10709791437"
            arrow.ImageColor3 = Theme["Color Text"]
            arrow.Size    = UDim2.new(0, 14, 0, 14)
            arrow.Position = UDim2.new(1, -16, 0.5, 0)
            arrow.AnchorPoint = Vector2.new(1, 0.5)
            arrow.Rotation = 0
            arrow.Name    = "ArrowLabel"

            local bottomLine = InsertTheme(Instance.new("Frame"), "Theme")
            bottomLine.Parent = wrapper
            bottomLine.BackgroundColor3 = barColor
            bottomLine.BackgroundTransparency = 1
            bottomLine.Size  = UDim2.new(1, 0, 0, 1)
            bottomLine.Position = UDim2.new(0, 0, 0, 26)
            bottomLine.Name  = "BottomLine"

            local inner = Instance.new("Frame")
            inner.Parent = wrapper
            inner.BackgroundTransparency = 1
            inner.Size   = UDim2.new(1, 0, 0, 0)
            inner.Position = UDim2.new(0, 0, 0, 27)
            inner.Visible = false
            inner.Name   = "SectionInner"
            local innerLayout = Instance.new("UIListLayout")
            innerLayout.Parent    = inner
            innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
            innerLayout.Padding   = UDim.new(0, 5)
            local innerPad = Instance.new("UIPadding")
            innerPad.PaddingTop    = UDim.new(0, 5)
            innerPad.PaddingBottom = UDim.new(0, 5)
            innerPad.Parent = inner

            local isOpen = false

            local function GetInnerHeight()
                local h, count = 0, 0
                for _, ch in ipairs(inner:GetChildren()) do
                    if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and ch.Visible then
                        h = h + ch.Size.Y.Offset
                        count = count + 1
                    end
                end
                if count > 0 then h = h + (count - 1) * 5 end
                h = h + 10
                return h
            end

            local function RefreshSize()
                task.defer(function()
                    if isOpen then
                        local ih = GetInnerHeight()
                        Tween(wrapper, { Size = UDim2.new(1, 0, 0, 24 + ih) }, 0.18)
                        Tween(inner,   { Size = UDim2.new(1, 0, 0, ih) }, 0.18)
                    else
                        Tween(wrapper, { Size = UDim2.new(1, 0, 0, 23) }, 0.18)
                        Tween(inner,   { Size = UDim2.new(1, 0, 0, 0) }, 0.18)
                    end
                end)
            end

            local function SetOpen(state)
                isOpen = state
                inner.Visible = isOpen
                Tween(arrow, { Rotation = isOpen and 90 or 0 }, 0.18)
                Tween(bottomLine, { BackgroundTransparency = isOpen and 0 or 1 }, 0.15)
                Tween(headerBtn,  { BackgroundTransparency = isOpen and 0.08 or 0 }, 0.15)
                RefreshSize()
            end

            headerBtn.MouseEnter:Connect(function()
                if not isOpen then Tween(headerBtn, { BackgroundTransparency = 0.35 }, 0.1) end
            end)
            headerBtn.MouseLeave:Connect(function()
                Tween(headerBtn, { BackgroundTransparency = isOpen and 0.08 or 0 }, 0.1)
            end)
            headerBtn.Activated:Connect(function() SetOpen(not isOpen) end)

            inner.ChildAdded:Connect(function()   if isOpen then RefreshSize() end end)
            inner.ChildRemoved:Connect(function() if isOpen then RefreshSize() end end)

            if startOpen then
                task.defer(function() SetOpen(true) end)
            else
                arrow.Rotation = 0
                bottomLine.BackgroundTransparency = 1
                wrapper.Size = UDim2.new(1, 0, 0, 23)
                inner.Size   = UDim2.new(1, 0, 0, 0)
                inner.Visible = false
            end

            function sectionObj:Set(name)
                if name then headerLabel.Text = tostring(name) end
            end
            function sectionObj:Visible(bool)
                wrapper.Visible = bool ~= nil and bool or not wrapper.Visible
            end
            function sectionObj:Destroy() wrapper:Destroy() end
            function sectionObj:Toggle() SetOpen(not isOpen) end
            function sectionObj:Open(bool) SetOpen(bool ~= nil and bool or true) end

            local function WithInner(method, cfg)
                local old = activeContainer
                activeContainer = inner
                local result = method(tabObj, cfg)
                activeContainer = old
                return result
            end

            function sectionObj:AddLabel(cfg)             return WithInner(tabObj.AddLabel,             cfg) end
            function sectionObj:AddButton(cfg, cb)        return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddButton(cfg,cb); activeContainer=oc; return r end)() end
            function sectionObj:AddSwitch(cfg, cb)        return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddSwitch(cfg,cb); activeContainer=oc; return r end)() end
            function sectionObj:AddTextBox(cfg, cb, o)    return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddTextBox(cfg,cb,o); activeContainer=oc; return r end)() end
            function sectionObj:AddSlider(cfg, cb, o)     return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddSlider(cfg,cb,o); activeContainer=oc; return r end)() end
            function sectionObj:AddKeybind(cfg, cb, o)    return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddKeybind(cfg,cb,o); activeContainer=oc; return r end)() end
            function sectionObj:AddDropdown(cfg, cb)      return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddDropdown(cfg,cb); activeContainer=oc; return r end)() end
            function sectionObj:AddColorPicker(cb)        return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddColorPicker(cb); activeContainer=oc; return r end)() end
            function sectionObj:AddHorizontalAlignment()  return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddHorizontalAlignment(); activeContainer=oc; return r end)() end
            function sectionObj:AddFolder(cfg)            return (function() local oc=activeContainer; activeContainer=inner; local r=tabObj:AddFolder(cfg); activeContainer=oc; return r end)() end
            function sectionObj:AddDivider(cfg)           return WithInner(tabObj.AddDivider, cfg) end

            return sectionObj
        end

        function tabObj:AddDivider(cfg)
            local dText = type(cfg) == "string" and cfg
                or (type(cfg) == "table" and (cfg[1] or cfg.Text or cfg.Title)) or nil

            local divFrame = Instance.new("Frame")
            divFrame.Parent = activeContainer
            divFrame.Size   = UDim2.new(1, 0, 0, dText and 20 or 10)
            divFrame.BackgroundTransparency = 1
            divFrame.Name   = "Divider"

            if dText then
                local lbl = InsertTheme(Instance.new("TextLabel"), "Text")
                lbl.Parent = divFrame
                lbl.BackgroundTransparency = 1
                lbl.Font   = Enum.Font.GothamBold
                lbl.Text   = dText
                lbl.TextColor3 = Theme["Color Text"]
                lbl.TextSize = 11
                lbl.Size   = UDim2.new(1, 0, 1, 0)
                lbl.TextXAlignment = Enum.TextXAlignment.Center
                lbl.TextYAlignment = Enum.TextYAlignment.Center
            else
                local line = InsertTheme(Instance.new("Frame"), "Stroke")
                line.Parent = divFrame
                line.BackgroundColor3 = Theme["Color Stroke"]
                line.Size  = UDim2.new(1, 0, 0, 1)
                line.Position = UDim2.new(0, 0, 0.5, 0)
                line.AnchorPoint = Vector2.new(0, 0.5)
            end

            local divObj = {}
            function divObj:Visible(b)
                divFrame.Visible = b ~= nil and b or not divFrame.Visible
            end
            function divObj:Destroy() divFrame:Destroy() end
            return divObj
        end

        function tabObj:Show() Activate() end

        return tabObj
    end -- AddTab

    function winObj:SetTheme(name)
        lib:SetTheme(name)
    end

    return winObj
end

ScreenGui.AncestryChanged:Connect(function()
    if not ScreenGui.Parent then DisconnectAll() end
end)

lib.AddWindow  = windowAPI.AddWindow
lib.SetTheme   = lib.SetTheme

setmetatable(lib, { __index = windowAPI })

return lib

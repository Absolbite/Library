local Theme     = Themes[Save.Theme]

local SAVE_FILE = "revenger_save.json"

local function SaveJson()
    if not writefile then return end
    local ok, enc = pcall(function()
        return HttpService:JSONEncode({ Theme = Save.Theme, Flags = Flags })
    end)
    if ok then pcall(writefile, SAVE_FILE, enc) end
end

local function LoadJson()
    if not readfile or not isfile then return end
    local ok1, exists = pcall(isfile, SAVE_FILE)
    if ok1 and exists then
        local ok2, raw = pcall(readfile, SAVE_FILE)
        if ok2 then
            local ok3, dec = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok3 and type(dec) == "table" then
                if type(dec.Flags) == "table" then
                    for k, v in pairs(dec.Flags) do Flags[k] = v end
                end
                if type(dec.Theme) == "string" and Themes[dec.Theme] then
                    Save.Theme = dec.Theme
                    Theme = Themes[dec.Theme]
                end
            end
        end
    end
end
LoadJson()

local function SetFlag(flag, value)
    if not flag then return end
    Flags[flag] = value
    SaveJson()
end
local function GetFlag(flag)
    return flag and Flags[flag]
end
local function CheckFlag(flag)
    return flag and Flags[flag] ~= nil
end

local function Tween(inst, props, t)
    t = t or 0.2
    local info = TweenInfo.new(t, Enum.EasingStyle.Quint)
    TweenService:Create(inst, info, props):Play()
end

local function InsertTheme(inst, type_)
    table.insert(Instances, { Instance = inst, Type = type_ })
    return inst
end

local function New(cls, parent, props, children)
    local obj = Instance.new(cls)
    if parent then obj.Parent = parent end
    if props then
        for k, v in pairs(props) do obj[k] = v end
    end
    if children then
        for _, ch in ipairs(children) do ch.Parent = obj end
    end
    return obj
end

local function Corner(parent, radius)
    return New("UICorner", parent, { CornerRadius = radius or UDim.new(0, 6) })
end
local function Stroke(parent, color, thickness)
    local s = InsertTheme(New("UIStroke", parent, {
        Color     = color or Theme["Stroke"],
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }), "Stroke")
    return s
end

local ViewportSize = workspace.CurrentCamera.ViewportSize
local UIScale = ViewportSize.Y / 450

local function GetColorProp(inst)
    if inst:IsA("Frame") or inst:IsA("TextButton") or inst:IsA("ImageButton") then return "BackgroundColor3"
    elseif inst:IsA("ImageLabel") then return "ImageColor3"
    elseif inst:IsA("TextLabel") or inst:IsA("TextBox") then return "TextColor3"
    elseif inst:IsA("ScrollingFrame") then return "ScrollBarImageColor3"
    elseif inst:IsA("UIStroke") then return "Color"
    end
end

local function ApplyTheme(newTheme)
    if not Themes[newTheme] then return end
    Save.Theme = newTheme
    Theme = Themes[newTheme]
    for _, v in ipairs(Instances) do
        if v.Instance and v.Instance.Parent then
            local inst = v.Instance
            if v.Type == "Hub1" then
                inst.BackgroundColor3 = Theme["Hub 1"]
            elseif v.Type == "Hub2" then
                local p = GetColorProp(inst)
                if p then inst[p] = Theme["Hub 2"] end
            elseif v.Type == "Stroke" then
                local p = GetColorProp(inst)
                if p then inst[p] = Theme["Stroke"] end
            elseif v.Type == "Theme" then
                local p = GetColorProp(inst)
                if p then inst[p] = Theme["Theme"] end
            elseif v.Type == "Text" then
                local p = GetColorProp(inst)
                if p then inst[p] = Theme["Text"] end
            elseif v.Type == "DarkText" then
                local p = GetColorProp(inst)
                if p then inst[p] = Theme["Dark Text"] end
            end
        end
    end
    SaveJson()
end


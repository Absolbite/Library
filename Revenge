        function bU:AddSlider(configs)
            configs = type(configs) == "table" and configs or {}
            local sName    = configs[1] or configs.Name or configs.Title or "Slider"
            local min      = tonumber(configs[2] or configs.Min or configs.MinValue or 0)
            local max      = tonumber(configs[3] or configs.Max or configs.MaxValue or 100)
            local default  = tonumber(configs[5] or configs.Default or min)
            local increase = tonumber(configs[4] or configs.Increase or 1)
            local flag     = configs.Flag or configs[7] or false
            local callback = type(configs[6]) == "function" and configs[6] or
                             type(configs.Callback) == "function" and configs.Callback or function() end

            if CheckFlag(flag) then default = tonumber(GetFlag(flag)) or default end
            default = math.clamp(default, min, max)

            local row = New("Frame", Container, {
                BackgroundTransparency  = 1,
                Size                    = UDim2.new(1, 0, 0, 34),
                Name                    = "Option",
            })
            InsertTheme(New("TextLabel", row, {
                BackgroundTransparency  = 1,
                Font                    = Enum.Font.GothamMedium,
                Text                    = sName,
                TextColor3              = Theme["Text"],
                TextSize                = 10,

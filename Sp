			})

			-- Авторасчёт размера (без task.wait внутри)
			local function GetContentHeight()
				local h = 0
				for _, child in ipairs(SectionContent:GetChildren()) do
					if child:IsA("GuiObject") then
						h = h + child.Size.Y.Offset + 3
					end
				end
				return math.max(h, 0)
			end

			local function ApplySectionSize(animate)
				if not isOpen then return end
				local contentH = GetContentHeight()
				local totalH   = 38 + contentH
				ArrowIcon.Rotation = 90
				if animate then
					CreateTween(SectionHolder,  { Size = UDim2.new(1, 1, 0, totalH) }, 0.2)
					CreateTween(SectionContent, { Size = UDim2.new(1, 0, 0, contentH) }, 0.2)
					CreateTween(SectionDivider, { Size = UDim2.new(1, 0, 0, 2) }, 0.2)
				else
					SectionHolder.Size  = UDim2.new(1, 1, 0, totalH)
					SectionContent.Size = UDim2.new(1, 0, 0, contentH)
					SectionDivider.Size = UDim2.new(1, 0, 0, 2)
				end
				UpdatePageCanvas()
			end

			local function RecalcSectionSize()
				ApplySectionSize(true)
			end


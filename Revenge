                Position                = UDim2.new(0, 5, 0, 0),
                TextXAlignment          = Enum.TextXAlignment.Left,
            }), "Text")

            local valLabel = InsertTheme(New("TextLabel", row, {
                BackgroundTransparency  = 1,
                Font                    = Enum.Font.GothamBold,
                Text                    = tostring(default),
                TextColor3              = Theme["Text"],
                TextSize                = 10,
                Size                    = UDim2.new(0.5, -5, 0, 16),
                Position                = UDim2.new(0.5, 5, 0, 0),
                TextXAlignment          = Enum.TextXAlignment.Right,
            }), "Text")

            local track = InsertTheme(New("Frame", row, {
                BackgroundColor3        = Theme["Stroke"],
                Size                    = UDim2.new(1, -10, 0, 5),
                Position                = UDim2.new(0, 5, 0, 22),
            }), "Stroke")
            Corner(track, UDim.new(0.5, 0))

            local fill = InsertTheme(New("Frame", track, {
                BackgroundColor3        = Theme["Theme"],
                Size                    = UDim2.fromScale(0, 1),
            }), "Theme")
            Corner(fill, UDim.new(0.5, 0))

            local knob = New("Frame", track, {
                BackgroundColor3        = Color3.fromRGB(220, 220, 220),
                Size                    = UDim2.new(0, 8, 0, 14),
                Position                = UDim2.fromScale(0, 0.5),
                AnchorPoint             = Vector2.new(0.5, 0.5),
                BackgroundTransparency  = 0.1,
            })
            Corner(knob)

            local cur = default
            local function V2S(v) if max == min then return 0 end return (v - min) / (max - min) end
            local function S2V(s) return math.clamp(math.floor(s * (max-min)/increase + 0.5)*increase + min, min, max) end

            local function Apply(v)
                v = math.clamp(v, min, max)
                v = math.floor(v / increase + 0.5) * increase
                cur = v
                local sc = V2S(v)
                fill.Size  = UDim2.fromScale(sc, 1)
                knob.Position = UDim2.new(sc, 0, 0.5, 0)
                valLabel.Text = tostring(v)
                SetFlag(flag, v)
                pcall(callback, v)
            end

            local dragBtn = New("TextButton", row, {
                BackgroundTransparency  = 1,
                Size                    = UDim2.new(1, -10, 0, 14),
                Position                = UDim2.new(0, 5, 0, 17),
                Text                    = "",
            })
            dragBtn.MouseButton1Down:Connect(function()
                while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    task.wait()
                    local mp  = UserInputService:GetMouseLocation()
                    local rel = math.clamp((mp.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    Apply(S2V(rel))
                end
            end)
            Apply(default)

            local S = {}
            function S:Set(v) if type(v) == "number" then Apply(v) end end
            function S:Visible(b) row.Visible = (b ~= nil) and b or (not row.Visible) end
            function S:Destroy() row:Destroy() end
            return S
        end


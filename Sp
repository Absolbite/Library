local Custom = {} do
  Custom.ColorRGB   = Color3.fromRGB(250, 7, 7)
  Custom.Background = Color3.fromRGB(15, 15, 15)
  Custom.Secondary  = Color3.fromRGB(25, 10, 10)
  Custom.ThemeName  = "Classic Red"
  Custom.Strength   = StrengthPresets.Normal
  Custom._ThemeListeners = {}
  Custom._StrengthListeners = {}
  
  function Custom:_ApplyTheme()
    for _, cb in ipairs(Custom._ThemeListeners) do
      pcall(cb, Custom.ColorRGB, Custom.Background, Custom.Secondary)
    end
  end
  
  function Custom:_ApplyStrength()
    for _, cb in ipairs(Custom._StrengthListeners) do
      pcall(cb, Custom.Strength)
    end
  end
  
  function Custom:OnThemeChanged(Callback)
    table.insert(Custom._ThemeListeners, Callback)
  end
  
  function Custom:OnStrengthChanged(Callback)
    table.insert(Custom._StrengthListeners, Callback)
  end
  
  function Custom:SetTheme(ThemeNameOrIndex)
    local Theme = nil

    if type(ThemeNameOrIndex) == "number" then
      Theme = Themes[ThemeNameOrIndex]
    elseif type(ThemeNameOrIndex) == "string" then
      for _, t in ipairs(Themes) do
        if t.Name:lower() == ThemeNameOrIndex:lower() then
          Theme = t
          break
        end
      end
    end

    if not Theme then
      warn("[SpLib] Theme not found: " .. tostring(ThemeNameOrIndex))
      return
    end

    Custom.ColorRGB   = Theme.Accent
    Custom.Background = Theme.Background
    Custom.Secondary  = Theme.Secondary
    Custom.ThemeName  = Theme.Name

    Custom:_ApplyTheme()
  end
  
  function Custom:SetStrength(StrengthNameOrValue)
    if type(StrengthNameOrValue) == "string" then
      local Preset = StrengthPresets[StrengthNameOrValue]
      if not Preset then
        warn("[SpLib] Strength preset not found: " .. StrengthNameOrValue)
        return
      end
      Custom.Strength = Preset
    elseif type(StrengthNameOrValue) == "number" then
      local v = math.clamp(StrengthNameOrValue, 0, 1)
      Custom.Strength = {
        MainTransparency  = 0.5  * (1 - v),
        ItemTransparency  = 0.97 - (0.12 * v),
        StrokeTransparency= 0.95 - (0.55 * v),
        StrokeThickness   = 0.8  + (1.7  * v),
      }
    end

    Custom:_ApplyStrength()
  end
  
  function Custom:GetThemeNames()
    local Names = {}
    for _, t in ipairs(Themes) do
      table.insert(Names, t.Name)
    end
    return Names
  end
  
  function Custom:GetStrengthNames()
    local Names = {}
    for k in pairs(StrengthPresets) do
      table.insert(Names, k)
    end
    return Names
  end

  function Custom:Create(Name, Properties, Parent)
    local _instance = Instance.new(Name)

    for i, v in pairs(Properties) do
      _instance[i] = v
    end

    if Parent then
      _instance.Parent = Parent
    end

    return _instance
  end

  function Custom:EnabledAFK()
    Player.Idled:Connect(function()
      VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
      task.wait(1)
      VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end)
  end
end

Custom:EnabledAFK()

local function OpenClose()
  local ScreenGui = Custom:Create("ScreenGui", {
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  }, RunService:IsStudio() and Player.PlayerGui or (gethui() or cloneref(game:GetService("CoreGui")) or game:GetService("CoreGui")))

  local Close_ImageButton = Custom:Create("ImageButton", {
    BackgroundColor3 = Color3.fromRGB(0, 0, 0),
    BorderColor3 = Color3.fromRGB(255, 255, 255),
    BackgroundTransparency = 1,
    Position = UDim2.new(0.1021, 0, 0.0743, 0),
    Size = UDim2.new(0, 59, 0, 49),
    Image = "rbxassetid://10734895698",
    Visible = false,
  }, ScreenGui)

  local UICorner = Custom:Create("UICorner", {
    Name = "MainCorner",
    CornerRadius = UDim.new(0, 9),
  }, Close_ImageButton)

  local dragging, dragStart, startPos = false, nil, nil

  local function UpdateDraggable(input)
    local delta = input.Position - dragStart
    Close_ImageButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
  end

  Close_ImageButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
      dragging = true
      dragStart = input.Position
      startPos = Close_ImageButton.Position

      input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
          dragging = false
        end
      end)
    end
  end)

  Close_ImageButton.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
      UpdateDraggable(input)
    end
  end)

  return Close_ImageButton
end

local Open_Close = OpenClose()

local function MakeDraggable(topbarobject, object)
  local dragging, dragStart, startPos = false, nil, nil

  local function UpdatePos(input)
    local delta = input.Position - dragStart
    local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    object.Position = newPos
  end

  topbarobject.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
      dragging = true
      dragStart = input.Position
      startPos = object.Position

      input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
          dragging = false
        end
      end)
    end
  end)

  topbarobject.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
      UpdatePos(input)
    end
  end)
end


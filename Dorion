-- ================================================================
--  FLAGS (global save/load)
-- ================================================================
local DorionFlags = {}  -- { [Flag] = value }

-- ================================================================
--  LIBRARY SETTINGS (saved to file)
-- ================================================================
local LibSettings = {
    Theme        = "Crimson",
    Transparency = 0,        -- 0.0 - 0.8
    Width        = 670,
    Height       = 420,
}

local function GetTheme(name)
    return Themes[name] or Themes["Crimson"]
end

-- ================================================================
--  MAKE WINDOW
-- ================================================================
function DorionLib:MakeWindow(cfg)
    cfg = cfg or {}

    local saveFolder   = cfg.SaveFolder or "DorionLib"
    local libSettingsFile = saveFolder .. "/DorionLibSettings.json"
    local flagsFile       = saveFolder .. "/flags.json"

    -- Ensure folder & load saved settings
    FolderEnsure(saveFolder)

    -- Load lib settings
    local rawLibCfg = FileRead(libSettingsFile)
    if rawLibCfg then
        local decoded = JsonDecode(rawLibCfg)
        for k,v in pairs(decoded) do LibSettings[k] = v end
    end

    -- Load flags
    local rawFlags = FileRead(flagsFile)
    if rawFlags then
        local decoded = JsonDecode(rawFlags)
        for k,v in pairs(decoded) do DorionFlags[k] = v end
    end

    local function SaveLibSettings()
        FileWrite(libSettingsFile, JsonEncode(LibSettings))
    end
    local function SaveFlags()
        FileWrite(flagsFile, JsonEncode(DorionFlags))
    end

    -- Apply cfg overrides (only if no saved settings)
    if cfg.Theme and not rawLibCfg then LibSettings.Theme = cfg.Theme end
    if cfg.Width  and not rawLibCfg then LibSettings.Width  = cfg.Width  end
    if cfg.Height and not rawLibCfg then LibSettings.Height = cfg.Height end

    local W = LibSettings.Width
    local H = LibSettings.Height
    local C = GetTheme(LibSettings.Theme)

    local title    = cfg.Title    or "DorionLib"
    local subtitle = cfg.Subtitle or ""
    local tag      = cfg.Tag      or ""
    local minimizeKey = cfg.MinimizeKey or Enum.KeyCode.RightShift

    local minBtnCfg = cfg.MinimizeButton or {}

    -- ScreenGui
    local gui = Create("ScreenGui", {
        Name           = "DorionLib_" .. tostring(math.random(1e5,9e5)),
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function() gui.Parent = CoreGui end)
    if not gui.Parent then gui.Parent = LocalPlayer.PlayerGui end

    -- Main frame
    local main = Create("Frame", {
        Name             = "MainFrame",
        Size             = UDim2.new(0, W, 0, H),
        Position         = UDim2.new(0.5, -W/2, 0.5, -H/2),
        BackgroundColor3 = C.BG,
        BackgroundTransparency = LibSettings.Transparency,
        BorderSizePixel  = 0,
        ClipsDescendants = false,
        Parent           = gui,
    })
    Create("UICorner", {CornerRadius=UDim.new(0,8), Parent=main})
    local mainStroke = Create("UIStroke", {Color=C.Border, Thickness=1, Parent=main})

    -- Shadow
    Create("ImageLabel", {
        Size=UDim2.new(1,40,1,40), Position=UDim2.new(0,-20,0,-20),
        BackgroundTransparency=1, Image="rbxassetid://5554236805",

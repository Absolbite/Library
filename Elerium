                    optBtn.BackgroundTransparency = 0.8
                    optBtn.BackgroundColor3 = barColor
                end)
                optBtn.MouseLeave:Connect(function()
                    optBtn.BackgroundTransparency = 1
                end)

                if boxOpen then
                    local h = CalcBoxH()
                    if boxFlipped then
                        Tween(box, {
                            Size     = UDim2.new(1, 0, 0, h),
                            Position = UDim2.new(0, 0, 0, -h - 5)
                        }, tweenT)
                    else
                        Tween(box, { Size = UDim2.new(1, 0, 0, h) }, tweenT)
                    end
                end

                optBtn.MouseButton1Click:Connect(function()
                    if boxOpen then
                        ddBtn.Text = "      [ " .. optName .. " ]"
                        CloseBox()
                        pcall(callback, optName)
                    end
                end)

                function optObj:Remove() optBtn:Destroy() end
                return optBtn, optObj
            end


        C = GetTheme(themeName)
        local dur = instant and 0 or 0.3
        for _, entry in ipairs(ThemeElements) do
            local el, prop, key = entry[1], entry[2], entry[3]
            if el and C[key] then
                if instant then
                    pcall(function() el[prop] = C[key] end)
                else
                    Tween(el, {[prop]=C[key]}, dur)
                end
            end
        end
        -- Update float btn
        if floatBtn then
            pcall(function()
                Tween(floatBtn, {BackgroundColor3=C.AccentDark}, dur)
            end)
        end
        SaveLibSettings()
    end

    ApplyTheme(LibSettings.Theme, true)

    -- ── RESIZE ──────────────────────────────────────────────────
    local function ApplySize(w, h, instant)
        LibSettings.Width  = w
        LibSettings.Height = h
        local newSize = UDim2.new(0, w, 0, h)
        local newPos  = UDim2.new(0.5, -w/2, 0.5, -h/2)
        if instant then
            main.Size     = newSize
            main.Position = newPos
        else
            Tween(main, {Size=newSize, Position=newPos}, 0.25)
        end
        SaveLibSettings()
    end

    -- ── TRANSPARENCY ────────────────────────────────────────────
    local function ApplyTransparency(val, instant)
        LibSettings.Transparency = val
        if instant then
            pcall(function() main.BackgroundTransparency = val end)
            pcall(function() header.BackgroundTransparency = val end)
        else
            Tween(main,   {BackgroundTransparency=val}, 0.2)
            Tween(header, {BackgroundTransparency=val}, 0.2)
        end
        SaveLibSettings()
    end

    ApplyTransparency(LibSettings.Transparency, true)

    -- ── DRAGGABLE (main) ────────────────────────────────────────
    MakeDraggable(main, header)

    -- ── MINIMIZE / CLOSE ────────────────────────────────────────
    local minimized = false

    local function setMinimized(val)
        minimized = val
        if minimized then
            Tween(main, {Size=UDim2.new(0,LibSettings.Width,0,0)}, 0.2)
            task.delay(0.21, function()
                main.Visible = false
                floatBtn.Visible = true
            end)
        else
            main.Visible = true
            floatBtn.Visible = false
            Tween(main, {Size=UDim2.new(0,LibSettings.Width,0,LibSettings.Height)}, 0.2)
        end
    end

    minimizeBtn.MouseButton1Click:Connect(function() setMinimized(true) end)
    floatBtn.MouseButton1Click:Connect(function() setMinimized(false) end)
    closeBtn.MouseButton1Click:Connect(function()
        Tween(main, {Size=UDim2.new(0,LibSettings.Width,0,0)}, 0.2)
        task.delay(0.22, function() gui:Destroy() floatGui:Destroy() end)
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == minimizeKey then
            setMinimized(not minimized)
        end
    end)

    -- Button hover effects
    closeBtn.MouseEnter:Connect(function() Tween(closeBtn, {BackgroundColor3=C.Accent}, 0.1) end)
    closeBtn.MouseLeave:Connect(function() Tween(closeBtn, {BackgroundColor3=C.AccentDark}, 0.1) end)
    minimizeBtn.MouseEnter:Connect(function() Tween(minimizeBtn, {BackgroundColor3=C.TabHover}, 0.1) end)
    minimizeBtn.MouseLeave:Connect(function() Tween(minimizeBtn, {BackgroundColor3=C.SectionHdr}, 0.1) end)


    if not floatGui.Parent then floatGui.Parent = LocalPlayer.PlayerGui end

    local floatBtnSize = minBtnCfg.Size or UDim2.new(0,44,0,44)
    local floatBtnPos  = minBtnCfg.Position or UDim2.new(0,18,0.5,-22)

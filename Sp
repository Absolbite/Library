				-- Открыть dropdown
				OpenBtn.Activated:Connect(function()
					if not DropdownOverlay.Visible then
						DropdownOverlay.Visible = true
						DropPageLayout:JumpToIndex(SelectFrame.LayoutOrder)
						CreateTween(DropdownOverlay, { BackgroundTransparency = 0.7 }, 0.2)
						CreateTween(DropdownSelectPanel, { Position = UDim2.new(1, -11, 0.5, 0) }, 0.2)
					end
				end)

				local optionCount = 0

				function DropObj:Clear()
					for _, child in ipairs(DropScrollPage:GetChildren()) do
						if child.Name == "Option" then
							DropObj.Value   = {}
							DropObj.Options = {}
							SelectedLabel.Text = "Select Options"
							child:Destroy()
						end
					end
				end

				function DropObj:Set(val)
					DropObj.Value = val or DropObj.Value
					for _, child in ipairs(DropScrollPage:GetChildren()) do
						if child.Name ~= "UIListLayout" then
							local selected = table.find(DropObj.Value, child.OptionText and child.OptionText.Text)
							if selected then
								CreateTween(child.ChooseFrame.UIStroke, { Transparency = 0 }, 0.2)
								CreateTween(child.ChooseFrame, { Size = UDim2.new(0, 1, 0, 12) }, 0.2)
								CreateTween(child, { BackgroundTransparency = 0.935 }, 0.2)
							else
								CreateTween(child.ChooseFrame, { Size = UDim2.new(0, 0, 0, 0) }, 0.1)
								CreateTween(child.ChooseFrame.UIStroke, { Transparency = 0.999 }, 0.1)
								CreateTween(child, { BackgroundTransparency = 0.999 }, 0.1)
							end
						end
					end
					local joined = table.concat(DropObj.Value, ", ")
					SelectedLabel.Text = (joined == "") and "Select Options" or joined
					elemCfg.Callback(DropObj.Value)
				end

				function DropObj:AddOption(optionText)
					optionText = optionText or "Option"
					local OptionFrame = Create("Frame", DropScrollPage, {
						BackgroundColor3 = Color3.fromRGB(255, 255, 255),
						BackgroundTransparency = 0.999,
						BorderSizePixel  = 0,
						LayoutOrder      = optionCount,
						Size             = UDim2.new(1, 0, 0, 30),
						Name             = "Option"
					})
					Make("UICorner", OptionFrame, { CornerRadius = UDim.new(0, 3) })

					local OptionBtn = Create("TextButton", OptionFrame, {
						Font               = Enum.Font.GothamBold,
						Text               = "",
						TextColor3         = Color3.fromRGB(255, 255, 255),
						TextSize           = 13,
						TextXAlignment     = Enum.TextXAlignment.Left,
						BackgroundTransparency = 1,
						BorderSizePixel    = 0,
						Size               = UDim2.new(1, 0, 1, 0),
						Name               = "OptionButton"
					})

					Create("TextLabel", OptionFrame, {
						Font               = Enum.Font.GothamBold,
						Text               = optionText,
						TextColor3         = Color3.fromRGB(231, 231, 231),
						TextSize           = 13,
						TextXAlignment     = Enum.TextXAlignment.Left,
						TextYAlignment     = Enum.TextYAlignment.Top,
						BackgroundTransparency = 1,
						BorderSizePixel    = 0,
						Position           = UDim2.new(0, 8, 0, 8),
						Size               = UDim2.new(1, -100, 0, 13),
						Name               = "OptionText"
					})

					local ChooseIndicator = Create("Frame", OptionFrame, {
						AnchorPoint        = Vector2.new(0, 0.5),
						BackgroundColor3   = cfg.Color,
						BorderSizePixel    = 0,
						Position           = UDim2.new(0, 2, 0.5, 0),
						Size               = UDim2.new(0, 0, 0, 0),
						Name               = "ChooseFrame"
					})
					Make("UIStroke", ChooseIndicator, {
						Color        = cfg.Color,
						Thickness    = 1.6,
						Transparency = 0.999
					})
					Make("UICorner", ChooseIndicator)

					OptionBtn.Activated:Connect(function()
						CircleClick(OptionBtn, Player:GetMouse().X, Player:GetMouse().Y)
						if elemCfg.Multi then
							if OptionFrame.BackgroundTransparency > 0.95 then
								table.insert(DropObj.Value, optionText)
								DropObj:Set(DropObj.Value)
							else
								for i, v in pairs(DropObj.Value) do
									if v == optionText then
										table.remove(DropObj.Value, i)
										break
									end
								end
								DropObj:Set(DropObj.Value)
							end
						else
							DropObj.Value = { optionText }
							DropObj:Set(DropObj.Value)
						end
					end)

					-- Обновить CanvasSize
					local total = 0
					for _, child in ipairs(DropScrollPage:GetChildren()) do
						if child.Name ~= "UIListLayout" then
							total = total + 3 + child.Size.Y.Offset
						end
					end
					DropScrollPage.CanvasSize = UDim2.new(0, 0, 0, total)
					optionCount = optionCount + 1
				end

				function DropObj:Refresh(options, defaults)
					options  = options  or {}
					defaults = defaults or {}
					DropObj:Clear()
					for _, opt in pairs(options) do
						DropObj:AddOption(opt)
						task.wait()
					end
					DropObj.Options = options
					DropObj:Set(defaults)
				end

				DropObj:Refresh(DropObj.Options, DropObj.Value)
				itemIndex = itemIndex + 1
				elemIndex = elemIndex + 1
				return DropObj
			end

			return SectionObj
		end -- AddSection

		return Section
	end -- CreateTab

	return guiObj
end

return Lib

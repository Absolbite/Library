        ScaleType=Enum.ScaleType.Slice, SliceCenter=Rect.new(23,23,277,277),
        ZIndex=0, Parent=main,
    })

    -- HEADER
    local headerH = subtitle~="" and 44 or 32
    local header = Create("Frame", {
        Name="Header", Size=UDim2.new(1,0,0,headerH),
        BackgroundColor3=C.Header, BorderSizePixel=0, ZIndex=3, Parent=main,
    })
    Create("UICorner", {CornerRadius=UDim.new(0,8), Parent=header})
    Create("Frame", {
        Size=UDim2.new(1,0,0,8), Position=UDim2.new(0,0,1,-8),
        BackgroundColor3=C.Header, BorderSizePixel=0, ZIndex=3, Parent=header,
    })
    local accentBar = Create("Frame", {
        Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=C.Accent, BorderSizePixel=0, ZIndex=4, Parent=header,
    })

    -- Title row
    local titleLabel = Create("TextLabel", {

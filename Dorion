        Size=UDim2.new(0,1,1,0), Position=UDim2.new(0,158,0,0),
        BackgroundColor3=C.Border, BorderSizePixel=0, Parent=body,
    })

    -- CONTENT
    local content = Create("Frame", {
        Name="Content", Size=UDim2.new(1,-159,1,0),
        Position=UDim2.new(0,159,0,0),
        BackgroundColor3=C.Content, BorderSizePixel=0, Parent=body,
    })

    local contentTitle = Create("TextLabel", {
        Text="", Size=UDim2.new(1,-12,0,36),
        Position=UDim2.new(0,12,0,0),
        BackgroundTransparency=1, TextColor3=C.Text,
        TextSize=18, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left, Parent=content,
    })

    local contentScroll = Create("ScrollingFrame", {
        Size=UDim2.new(1,-6,1,-38), Position=UDim2.new(0,4,0,36),
        BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=3, ScrollBarImageColor3=C.Scrollbar,
        CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
        Parent=content,
    })
    Create("UIPadding", {PaddingLeft=UDim.new(0,4), PaddingRight=UDim.new(0,8), PaddingBottom=UDim.new(0,8), Parent=contentScroll})

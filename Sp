local SetProps, SetChildren, InsertTheme, Create, Make do
	InsertTheme = function(inst, themeType)
		table.insert(Lib.Instances, { Instance = inst, Type = themeType })
		return inst
	end

	SetProps = function(inst, props)
		if props then
			for prop, val in pairs(props) do
				inst[prop] = val
			end
		end
		return inst
	end

	SetChildren = function(inst, children)
		if children then
			for _, child in ipairs(children) do
				child.Parent = inst
			end
		end
		return inst
	end

	Create = function(className, parentOrProps, propsOrChildren, children)
		local new = Instance.new(className)
		if typeof(parentOrProps) == "Instance" then
			new.Parent = parentOrProps
			if propsOrChildren then SetProps(new, propsOrChildren) end
			if children then SetChildren(new, children) end
		else
			if parentOrProps then SetProps(new, parentOrProps) end
			if propsOrChildren then SetChildren(new, propsOrChildren) end
		end
		return new
	end

	Make = function(className, parent, props)
		local new = Instance.new(className)
		if parent and typeof(parent) == "Instance" then new.Parent = parent end
		if props then SetProps(new, props) end
		return new
	end
end

local function CreateTween(inst, props, time, style, dir)
	style = style or Enum.EasingStyle.Quad
	dir   = dir   or Enum.EasingDirection.InOut
	local tween = TweenService:Create(inst, TweenInfo.new(time or 0.2, style, dir), props)
	tween:Play()
	return tween
end

local function MakeDraggable(titleBar, window)
	local dragging, dragStart, startPos = false, nil, nil

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging  = true
			dragStart = input.Position
			startPos  = window.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	titleBar.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function MakeResizable(resizeHandle, window, minW, minH)
	local resizing, resizeStart, startSize = false, nil, nil

	resizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing    = true
			resizeStart = input.Position
			startSize   = window.Size
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
				end
			end)
		end
	end)

	resizeHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			if resizing then
				local delta = input.Position - resizeStart
				local newW  = math.max(startSize.X.Offset + delta.X, minW)
				local newH  = math.max(startSize.Y.Offset + delta.Y, minH)
				CreateTween(window, { Size = UDim2.new(0, newW, 0, newH) }, 0.2)
			end
		end
	end)
end

local function CircleClick(frame, mouseX, mouseY)
	task.spawn(function()
		frame.ClipsDescendants = true
		local ripple = Create("ImageLabel", frame, {
			Image              = "rbxassetid://266543268",
			ImageColor3        = Color3.fromRGB(80, 80, 80),
			ImageTransparency  = 0.9,
			BackgroundTransparency = 1,
			ZIndex             = 10,
			Name               = "Ripple"
		})
		local ox = mouseX - ripple.AbsolutePosition.X
		local oy = mouseY - ripple.AbsolutePosition.Y
		ripple.Position = UDim2.new(0, ox, 0, oy)
		local size = math.max(frame.AbsoluteSize.X, frame.AbsoluteSize.Y) * 1.5
		local dur  = 0.5
		ripple:TweenSizeAndPosition(
			UDim2.new(0, size, 0, size),
			UDim2.new(0.5, -size/2, 0.5, -size/2),
			"Out", "Quad", dur, false, nil
		)
		for _ = 1, 10 do
			ripple.ImageTransparency = ripple.ImageTransparency + 0.01
			task.wait(dur / 10)
		end
		ripple:Destroy()
	end)
end


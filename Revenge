local function MakeDrag(inst)
    task.spawn(function()
        inst.Active = true
        local DragStart, StartPos, InputOn

        local function Update(inp)
            local delta = inp.Position - DragStart
            local pos = UDim2.new(
                StartPos.X.Scale, StartPos.X.Offset + delta.X / UIScale,
                StartPos.Y.Scale, StartPos.Y.Offset + delta.Y / UIScale
            )
            Tween(inst, { Position = pos }, 0.25)
        end

        inst.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                StartPos  = inst.Position
                DragStart = inp.Position
                InputOn   = true
                while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                    RunService.Heartbeat:Wait()
                    if InputOn then Update(inp) end
                end
                InputOn = false
            end
        end)
    end)
    return inst
end


  Minimal    = {MainTransparency = 0.5,  ItemTransparency = 0.97, StrokeTransparency = 0.95, StrokeThickness = 0.8},
  Light      = {MainTransparency = 0.3,  ItemTransparency = 0.95, StrokeTransparency = 0.85, StrokeThickness = 1.0},

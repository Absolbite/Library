-- ─── FLAGS / SAVE ────────────────────────────────────────────────────────────
local Flags = {}
local SaveFile = nil

local function SaveFlags()
	if not writefile or not SaveFile then return end
	local ok, encoded = pcall(function() return HttpService:JSONEncode(Flags) end)
	if ok then pcall(writefile, SaveFile, encoded) end
end

local function LoadFlags()
	if not readfile or not isfile or not SaveFile then return end
	local ok, exists = pcall(isfile, SaveFile)
	if ok and exists then
		local ok2, data = pcall(readfile, SaveFile)
		if ok2 and type(data) == "string" then
			local ok3, decoded = pcall(function() return HttpService:JSONDecode(data) end)
			if ok3 and type(decoded) == "table" then
				Flags = decoded
			end
		end
	end
end

local function SetFlag(name, value)
	if not name then return end
	Flags[name] = value
	SaveFlags()
end

local function GetFlag(name)
	return Flags[name]
end


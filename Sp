				-- Логика
				local function RoundToIncrement(val, inc)
					local r = math.floor(val / inc + (math.sign(val) * 0.5)) * inc
					if r < 0 then r = r + inc end
					return r
				end

				function SliderObj:Set(val)
					val = math.clamp(RoundToIncrement(val, elemCfg.Increment), elemCfg.Min, elemCfg.Max)
					SliderObj.Value = val
					InputTextBox.Text = tostring(val)
					CreateTween(SliderFill, {
						Size = UDim2.fromScale((val - elemCfg.Min) / (elemCfg.Max - elemCfg.Min), 1)
					}, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				end

				local sliderDragging = false
				SliderTrack.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						sliderDragging = true
					end
				end)
				SliderTrack.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						sliderDragging = false
						elemCfg.Callback(SliderObj.Value)
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if sliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
						local pct = math.clamp(
							(input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X,
							0, 1
						)
						SliderObj:Set(elemCfg.Min + ((elemCfg.Max - elemCfg.Min) * pct))
					end
				end)

				InputTextBox:GetPropertyChangedSignal("Text"):Connect(function()
					local cleaned = InputTextBox.Text:gsub("[^%d]", "")
					if cleaned ~= "" then
						InputTextBox.Text = tostring(math.min(tonumber(cleaned), elemCfg.Max))
					else
						InputTextBox.Text = cleaned
					end
				end)
				InputTextBox.FocusLost:Connect(function()
					if InputTextBox.Text ~= "" then
						SliderObj:Set(tonumber(InputTextBox.Text))
					else
						SliderObj:Set(0)
					end
				end)

				SliderObj:Set(elemCfg.Default)
				elemIndex = elemIndex + 1
				return SliderObj
			end


local function ripple(btn, x, y)
	spawn(function()
		btn.ClipsDescendants = true
		local lbl = Instance.new("ImageLabel")
		lbl.Image = "rbxassetid://266543268"
		lbl.ImageColor3 = Color3.fromRGB(80,80,80)
		lbl.ImageTransparency = 0.85
		lbl.BackgroundTransparency = 1
		lbl.ZIndex = btn.ZIndex + 10
		lbl.Name = "Ripple"
		lbl.Parent = btn
		lbl.Position = UDim2.new(0, x - btn.AbsolutePosition.X, 0, y - btn.AbsolutePosition.Y)
		local sz = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.5
		lbl:TweenSizeAndPosition(
			UDim2.new(0,sz,0,sz),
			UDim2.new(0.5,-sz/2, 0.5,-sz/2),
			"Out","Quad",0.5,false,nil
		)
		for i=1,10 do lbl.ImageTransparency = lbl.ImageTransparency + 0.01; task.wait(0.05) end
		lbl:Destroy()
	end)
end


		local Size = math.max(Button.AbsoluteSize.X, Button.AbsoluteSize.Y) * 1.5

		local Time = 0.5
		local TweenInfo = TweenInfo.new(Time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		local Tween = TweenService:Create(Circle, TweenInfo, {
			Size = UDim2.new(0, Size, 0, Size),
			Position = UDim2.new(0.5, -Size/2, 0.5, -Size/2)
		})
		
		Tween:Play()
		
		Tween.Completed:Connect(function()
			for i = 1, 10 do
				Circle.ImageTransparency = Circle.ImageTransparency + 0.01
				wait(Time / 10)
			end
			Circle:Destroy()
		end)
	end)
end

local SpLib, Notification = {}, {}

SpLib.Unloaded = false
SpLib.Flags    = {}

local HttpService = game:GetService("HttpService")

local function _SafeFS(fn, ...)
  local ok, res = pcall(fn, ...)
  return ok and res or nil
end

local function _EnsureDir(path)
  if not _SafeFS(isfolder, path) then
    _SafeFS(makefolder, path)
  end
end

local function _PlaceName()
  local name = _SafeFS(function()
    return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
  end)
  return (name or tostring(game.PlaceId)):gsub('[\\/:*?"<>|]', "_")
end

local function _PlayerName()
  return Player.Name:gsub('[\\/:*?"<>|]', "_")
end

local function _FlagPath()
  local base  = "SpLib"
  local place = _PlaceName()
  _EnsureDir(base)
  _EnsureDir(base .. "/" .. place)
  return base .. "/" .. place .. "/" .. _PlayerName()
end

local function _LibSettingsPath()
  local base = "SpLib"
  _EnsureDir(base)
  return base .. "/Library Settings"
end

local function _LoadFlags()
  local path = _SafeFS(_FlagPath)
  if not path then return {} end
  local raw = _SafeFS(readfile, path)
  if not raw or raw == "" then return {} end
  return _SafeFS(HttpService.JSONDecode, HttpService, raw) or {}
end

local function _SaveFlags()
  local path = _SafeFS(_FlagPath)
  if not path then return end
  local data = {}
  for flag, funcs in pairs(SpLib.Flags) do
    data[flag] = funcs.Value
  end
  _SafeFS(writefile, path, HttpService:JSONEncode(data))
end

local function _LoadLibSettings()
  local path = _SafeFS(_LibSettingsPath)
  if not path then return {} end
  local raw = _SafeFS(readfile, path)
  if not raw or raw == "" then return {} end
  return _SafeFS(HttpService.JSONDecode, HttpService, raw) or {}
end

local function _SaveLibSettings()
  local path = _SafeFS(_LibSettingsPath)
  if not path then return end
  local data = {
    Theme    = Custom.ThemeName,
    Strength = (function()
      for name, preset in pairs(StrengthPresets) do
        if preset == Custom.Strength then return name end
      end
      return "Normal"
    end)()
  }
  _SafeFS(writefile, path, HttpService:JSONEncode(data))
end

SpLib._LoadFlags       = _LoadFlags
SpLib._SaveFlags       = _SaveFlags
SpLib._LoadLibSettings = _LoadLibSettings
SpLib._SaveLibSettings = _SaveLibSettings

function SpLib:SaveFlags() _SaveFlags() end
function SpLib:LoadFlags()
  local data = _LoadFlags()
  for flag, value in pairs(data) do
    local funcs = SpLib.Flags[flag]
    if funcs and funcs.Set then
      pcall(funcs.Set, funcs, value)
    end
  end
end

local function RegisterFlag(Flag, Funcs)
  if Flag and Flag ~= "" then
    SpLib.Flags[Flag] = Funcs
    local origSet = Funcs.Set
    if origSet then
      Funcs.Set = function(self, Value, ...)
        origSet(self, Value, ...)
        _SaveFlags()
      end
    end
  end
end


function SpLib:SetTheme(ThemeNameOrIndex)
  Custom:SetTheme(ThemeNameOrIndex)
  _SaveLibSettings()
end

function SpLib:SetStrength(StrengthNameOrValue)
  Custom:SetStrength(StrengthNameOrValue)
  _SaveLibSettings()
end


                    pcall(callback, inputBox.Text)
                end)
                inputBox.Focused:Connect(function() Tween(inputBox,{BackgroundColor3=C.SectionHdr},0.1) end)
                inputBox.FocusLost:Connect(function() Tween(inputBox,{BackgroundColor3=C.InputBG},0.1) end)
                row.MouseEnter:Connect(function() Tween(row,{BackgroundColor3=C.RowHover},0.1) end)
                row.MouseLeave:Connect(function() Tween(row,{BackgroundColor3=C.Row},0.1) end)

                if flag and DorionFlags[flag] ~= nil then pcall(callback, value) end

                local Obj = {}
                function Obj:Set(v) inputBox.Text=tostring(v); pcall(callback,v) end
                function Obj:Get() return inputBox.Text end
                return Obj
            end

            -- ====================================================
            --  AddSlider
            -- ====================================================
            function Section:AddSlider(cfg2)
                cfg2 = cfg2 or {}
                local name     = cfg2.Name     or "Slider"
                local flag     = cfg2.Flag
                local minV     = cfg2.Min      or 0
                local maxV     = cfg2.Max      or 100
                local default  = cfg2.Default  or minV
                local suffix   = cfg2.Suffix   or ""
                local callback = cfg2.Callback or function() end

                local value = math.clamp(default, minV, maxV)
                if flag and type(DorionFlags[flag])=="number" then
                    value = math.clamp(DorionFlags[flag], minV, maxV)
                end

                local row = Create("Frame", {
                    Size=UDim2.new(1,0,0,54), BackgroundColor3=C.Row,
                    BorderSizePixel=0, Parent=items,
                })
                Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=C.Border, BorderSizePixel=0, Parent=row})
                Create("TextLabel", {
                    Text=name, Size=UDim2.new(0.6,0,0,22), Position=UDim2.new(0,12,0,8),
                    BackgroundTransparency=1, TextColor3=C.TextDim, TextSize=13, Font=Enum.Font.Gotham,
                    TextXAlignment=Enum.TextXAlignment.Left, Parent=row,
                })
                local valLbl = Create("TextLabel", {
                    Text=tostring(value)..suffix, Size=UDim2.new(0.4,-12,0,22), Position=UDim2.new(0.6,0,0,8),
                    BackgroundTransparency=1, TextColor3=C.Accent, TextSize=13, Font=Enum.Font.GothamBold,
                    TextXAlignment=Enum.TextXAlignment.Right, Parent=row,
                })
                local track = Create("Frame", {
                    Size=UDim2.new(1,-24,0,6), Position=UDim2.new(0,12,0,36),
                    BackgroundColor3=C.Toggle_OFF, BorderSizePixel=0, Parent=row,
                })
                Create("UICorner", {CornerRadius=UDim.new(1,0), Parent=track})
                local rel0 = (value-minV)/(maxV-minV)
                local fill = Create("Frame", {
                    Size=UDim2.new(rel0,0,1,0), BackgroundColor3=C.Accent,
                    BorderSizePixel=0, Parent=track,
                })
                Create("UICorner", {CornerRadius=UDim.new(1,0), Parent=fill})
                local thumb = Create("Frame", {
                    Size=UDim2.new(0,14,0,14), Position=UDim2.new(rel0,0,0.5,-7),
                    BackgroundColor3=rgb(255,255,255), BorderSizePixel=0,
                    AnchorPoint=Vector2.new(0.5,0), Parent=track,
                })
                Create("UICorner", {CornerRadius=UDim.new(1,0), Parent=thumb})

                local dragging = false
                local function update(x)
                    local rel = math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
                    value = math.floor(minV+(maxV-minV)*rel)
                    valLbl.Text = tostring(value)..suffix
                    fill.Size = UDim2.new(rel,0,1,0)
                    thumb.Position = UDim2.new(rel,0,0.5,-7)
                    if flag then DorionFlags[flag]=value; SaveFlags() end
                    pcall(callback, value)
                end
                track.InputBegan:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                        dragging=true; update(i.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                        update(i.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                        dragging=false
                    end
                end)
                row.MouseEnter:Connect(function() Tween(row,{BackgroundColor3=C.RowHover},0.1) end)
                row.MouseLeave:Connect(function() Tween(row,{BackgroundColor3=C.Row},0.1) end)

                if flag and type(DorionFlags[flag])=="number" then pcall(callback, value) end

                local Obj = {}
                function Obj:Set(v)
                    value=math.clamp(v,minV,maxV)
                    local rel=(value-minV)/(maxV-minV)
                    valLbl.Text=tostring(value)..suffix
                    fill.Size=UDim2.new(rel,0,1,0)
                    thumb.Position=UDim2.new(rel,0,0.5,-7)
                    if flag then DorionFlags[flag]=value; SaveFlags() end
                    pcall(callback,value)
                end
                function Obj:Get() return value end
                return Obj
            end

            -- ====================================================
            --  AddButton
            -- ====================================================
            function Section:AddButton(cfg2)
                cfg2 = cfg2 or {}
                local name     = cfg2.Name     or "Button"
                local callback = cfg2.Callback or function() end

                local row = Create("Frame", {
                    Size=UDim2.new(1,0,0,44), BackgroundColor3=C.Row,
                    BorderSizePixel=0, Parent=items,
                })
                Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=C.Border, BorderSizePixel=0, Parent=row})

                local btn = Create("TextButton", {
                    Text=name, Size=UDim2.new(1,-24,0,28), Position=UDim2.new(0,12,0.5,-14),
                    BackgroundColor3=C.AccentDark, BorderSizePixel=0, TextColor3=C.Text,
                    TextSize=13, Font=Enum.Font.GothamSemibold, AutoButtonColor=false, Parent=row,
                })
                Create("UICorner", {CornerRadius=UDim.new(0,5), Parent=btn})

                btn.MouseButton1Click:Connect(function()
                    Tween(btn,{BackgroundColor3=C.Accent},0.1)
                    task.delay(0.15,function() Tween(btn,{BackgroundColor3=C.AccentDark},0.1) end)
                    pcall(callback)
                end)
                btn.MouseEnter:Connect(function() Tween(btn,{BackgroundColor3=C.Accent},0.1) end)
                btn.MouseLeave:Connect(function() Tween(btn,{BackgroundColor3=C.AccentDark},0.1) end)
                row.MouseEnter:Connect(function() Tween(row,{BackgroundColor3=C.RowHover},0.1) end)
                row.MouseLeave:Connect(function() Tween(row,{BackgroundColor3=C.Row},0.1) end)
            end

            -- ====================================================
            --  AddLabel
            -- ====================================================
            function Section:AddLabel(cfg2)
                cfg2 = cfg2 or {}
                local text = type(cfg2)=="string" and cfg2 or (cfg2.Text or "Label")
                local row = Create("Frame", {
                    Size=UDim2.new(1,0,0,36), BackgroundColor3=C.Row,
                    BorderSizePixel=0, Parent=items,
                })
                Create("Frame", {Size=UDim2.new(1,0,0,1), BackgroundColor3=C.Border, BorderSizePixel=0, Parent=row})
                local lbl = Create("TextLabel", {
                    Text=text, Size=UDim2.new(1,-24,1,0), Position=UDim2.new(0,12,0,0),
                    BackgroundTransparency=1, TextColor3=C.TextMuted, TextSize=12,
                    Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left,
                    TextWrapped=true, Parent=row,
                })
                local Obj = {}
                function Obj:Set(t) lbl.Text=t end
                return Obj
            end

            return Section
        end -- MakeSection

        return tabObj
    end -- MakeTab

    -- ════════════════════════════════════════════════════════════
    --  AUTO Settings Tab
    -- ════════════════════════════════════════════════════════════
    local settingsTab = Window:MakeTab({Name="⚙ Settings", Icon="⚙"})

    -- Theme section
    local themeSection = settingsTab:MakeSection("🎨 Themes")
    themeSection.sectionOpen = true -- open by default
    -- click to open it
    -- (we call the toggle manually)

    -- Build sorted theme list
    local themeNames = {}
    for k,_ in pairs(Themes) do table.insert(themeNames, k) end
    table.sort(themeNames)

    themeSection:AddDropdown({
        Name  = "Active Theme",
        Flag  = "_DorionTheme",
        Options = themeNames,
        Default = {LibSettings.Theme},
        Callback = function(sel)
            if sel and sel[1] then
                ApplyTheme(sel[1], false)
            end
        end
    })

    -- Transparency section
    local uiSection = settingsTab:MakeSection("🖥 UI Settings")

    uiSection:AddSlider({
        Name    = "Transparency",
        Flag    = "_DorionTransp",
        Min     = 0, Max = 80, Default = math.floor(LibSettings.Transparency*100),
        Suffix  = "%",
        Callback = function(v)
            ApplyTransparency(v/100, false)
        end
    })

    -- Width slider
    uiSection:AddSlider({
        Name    = "Window Width",
        Flag    = "_DorionW",
        Min     = 400, Max = 900, Default = LibSettings.Width,
        Callback = function(v)
            ApplySize(v, LibSettings.Height, false)
        end
    })

    -- Height slider
    uiSection:AddSlider({
        Name    = "Window Height",
        Flag    = "_DorionH",
        Min     = 280, Max = 620, Default = LibSettings.Height,
        Callback = function(v)
            ApplySize(LibSettings.Width, v, false)
        end
    })

    -- Reset settings
    uiSection:AddButton({
        Name = "Reset UI Settings",
        Callback = function()
            LibSettings = {Theme="Crimson", Transparency=0, Width=670, Height=420}
            ApplyTheme("Crimson", false)
            ApplyTransparency(0, false)
            ApplySize(670, 420, false)
            SaveLibSettings()
        end
    })

    -- Minimize button config section
    local minSection = settingsTab:MakeSection("📌 Minimize Button")
    minSection:AddLabel({Text="Drag the floating ☰ button anywhere on screen. Hold & drag to reposition."})

    return Window
end

-- ================================================================
--  MODULE RETURN
-- ================================================================
return DorionLib

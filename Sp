		or (pcall(function() return gethui() end) and gethui())
		or (pcall(function() return cloneref(game:GetService("CoreGui")) end) and cloneref(game:GetService("CoreGui")))
		or game:GetService("CoreGui")
end

local function tween(inst, info, props)
	TweenService:Create(inst, info, props):Play()
end

local function tweenLinear(inst, t, props)
	tween(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), props)
end


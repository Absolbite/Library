local function Ripple(parent, mx, my)
    task.spawn(function()
        parent.ClipsDescendants = true
        local circle = Instance.new("Frame")
        circle.Parent = parent
        circle.ZIndex = 1000
        circle.BackgroundColor3 = Color3.new(1, 1, 1)
        circle.BackgroundTransparency = 0.7
        circle.BorderSizePixel = 0
        local uic = Instance.new("UICorner")
        uic.CornerRadius = UDim.new(0.5, 0)
        uic.Parent = circle
        local px = mx - circle.AbsolutePosition.X
        local py = my - circle.AbsolutePosition.Y
        circle.Size = UDim2.new(0, 0, 0, 0)
        circle.Position = UDim2.new(0, px, 0, py)
        local bb = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 1.5
        circle:TweenSizeAndPosition(
            UDim2.new(0, bb, 0, bb),
            UDim2.new(0.5, -bb / 2, 0.5, -bb / 2),
            Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.5, false
        )
        Tween(circle, { BackgroundTransparency = 1 }, 0.5)
        task.wait(0.5)
        if circle and circle.Parent then circle:Destroy() end
    end)
end


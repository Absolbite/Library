				Instance.new("UICorner",knob).CornerRadius = UDim.new(0,10)

				local knobStroke = Instance.new("UIStroke")
				knobStroke.Color = guiColor
				knobStroke.Thickness = 1
				knobStroke.Parent = knob

				local sliderObj = { Value = elemCfg.Default }

				local function snapValue(v)
					local inc = elemCfg.Increment
					return math.clamp(
						math.floor(v / inc + (math.sign(v)*0.5)) * inc,
						elemCfg.Min, elemCfg.Max
					)
				end

				function sliderObj:Set(val)
					val = snapValue(val)
					self.Value = val
					valueBox.Text = tostring(val)
					if elemCfg.Flag then SetFlag(elemCfg.Flag, val) end
					local pct = (val - elemCfg.Min) / math.max(0.001, elemCfg.Max - elemCfg.Min)
					tweenLinear(fill, 0.15, { Size = UDim2.fromScale(pct, 1) })
				end

				-- Touch + Mouse dragging
				local sliding = false
				local lastSliderInput = nil

				track.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
						sliding = true
						local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
						sliderObj:Set(elemCfg.Min + (elemCfg.Max - elemCfg.Min) * pct)
						input.Changed:Connect(function()
							if input.UserInputState == Enum.UserInputState.End then
								sliding = false
								elemCfg.Callback(sliderObj.Value)
							end
						end)
					end
				end)

				track.InputChanged:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch then
						lastSliderInput = input
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if input == lastSliderInput and sliding then
						local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
						sliderObj:Set(elemCfg.Min + (elemCfg.Max - elemCfg.Min) * pct)
					end
				end)

				valueBox:GetPropertyChangedSignal("Text"):Connect(function()
					local clean = valueBox.Text:gsub("[^%d%-]","")
					if clean ~= "" then
						local n = math.min(tonumber(clean) or elemCfg.Min, elemCfg.Max)
						valueBox.Text = tostring(n)
					end
				end)

				valueBox.FocusLost:Connect(function()
					sliderObj:Set(tonumber(valueBox.Text) or elemCfg.Min)
					elemCfg.Callback(sliderObj.Value)
				end)

				sliderObj:Set(elemCfg.Default)
				elemIndex += 1
				return sliderObj
			end

